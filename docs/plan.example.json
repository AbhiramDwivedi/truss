{
  "version": 2,
  "goal": "Add rate limiting to the public API, with per-key quotas stored in Postgres",
  "architecture": "docs/architecture.md",
  "approval": "client",
  "approvedAt": null,
  "maxParallelCrews": 4,
  "reworkAllowance": 2,
  "crews": [
    {
      "slug": "ratelimit-design",
      "stage": 0,
      "verdict": "design",
      "modules": ["gateway", "quotas"],
      "owns": [
        "docs/architecture.md",
        "docs/adr/0007-rate-limiting.md",
        "tests/contract/quota-store.test.ts"
      ],
      "acceptanceTest": "pnpm test -- tests/contract/quota-store.test.ts",
      "acceptanceTestProved": true,
      "estAgents": 5,
      "status": "planned"
    },
    {
      "slug": "quotas",
      "stage": 1,
      "verdict": "change",
      "modules": ["quotas"],
      "owns": ["src/quotas/**", "migrations/0012_quotas.sql", "tests/quotas/**"],
      "acceptanceTest": "pnpm test -- quotas",
      "acceptanceTestProved": true,
      "estAgents": 8,
      "status": "planned",
      "needs": [
        {
          "id": "postgres",
          "why": "the quota store tests run against a local Postgres",
          "probe": { "kind": "command", "run": "pg_isready -q" },
          "allow": ["Bash(pg_isready:*)"]
        },
        {
          "id": "node-modules",
          "why": "pnpm test needs the installed packages",
          "probe": { "kind": "file", "path": "node_modules" },
          "allow": ["Bash(pnpm install --frozen-lockfile:*)"],
          "download": "pnpm install --frozen-lockfile"
        }
      ]
    },
    {
      "slug": "gateway",
      "stage": 1,
      "verdict": "extend",
      "modules": ["gateway"],
      "owns": ["src/gateway/middleware/ratelimit.ts", "tests/gateway/ratelimit.test.ts"],
      "acceptanceTest": "pnpm test -- gateway/ratelimit",
      "acceptanceTestProved": true,
      "estAgents": 6,
      "status": "planned"
    }
  ]
}
